"""Line-parsing utilities for tokenizing text lines."""


def parse_line(line):
    """Return a dict with the raw line and its whitespace-split tokens.

    Args:
        line: A string to parse.

    Returns:
        A dict with keys "raw" (the original string) and "words" (list of tokens).
    """
    return {"raw": line, "words": line.split()}


def count_tokens(line):
    """Return the number of whitespace-separated tokens in a line.

    Args:
        line: A string to count tokens in.

    Returns:
        An integer token count.
    """
    return len(line.split())
